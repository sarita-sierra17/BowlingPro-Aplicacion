{
  "expo": {
    "name": "BowlingPro",
    "slug": "bowlingpro",
    "scheme": "bowlingpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": ["expo-router"],
    "experiments": {
      "baseUrl": "/BowlingPro-Aplicacion",
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1326",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "BowlingPro",
      "lang": "es",
      "themeColor": "#0B1326",
      "favicon": "./assets/favicon.png"
    }
  }
}
